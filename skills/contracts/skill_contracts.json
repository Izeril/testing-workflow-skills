{
  "schema_version": "1.0.0",
  "skills": {
    "doc-to-md": {
      "public_entrypoints": [
        {
          "path": "doc-to-md/doc_to_md.py",
          "symbol": "convert_doc_to_md"
        }
      ],
      "cli": "doc-to-md/doc_to_md.py",
      "input": {
        "type": "object",
        "required": [
          "input_path"
        ],
        "optional": [
          "output_dir",
          "converter_path"
        ]
      },
      "output_artifact": "doc_conversion",
      "compatibility": [
        "UnsupportedDocFormatError"
      ]
    },
    "testcase-generator": {
      "public_entrypoints": [
        {
          "path": "testcase-generator/scripts/main.py",
          "symbol": "cli_entrypoint"
        }
      ],
      "cli": "testcase-generator/scripts/main.py",
      "input": {
        "type": "object",
        "required": [
          "directory"
        ],
        "optional": [
          "repo",
          "branch",
          "baseline",
          "step",
          "code_targets",
          "source_documents",
          "refresh_documents",
          "codegraph_policy",
          "impact_evidence"
        ]
      },
      "output_artifact": "workflow_metrics",
      "compatibility": [
        "workflow_analysis.run_requirement_analysis",
        "workflow_testpoint.run_testpoint_generate"
      ]
    },
    "xmind-generator": {
      "public_entrypoints": [
        {
          "path": "xmind-generator/xmind_utils.py",
          "symbol": "gen_id"
        },
        {
          "path": "xmind-generator/xmind_utils.py",
          "symbol": "make_node"
        },
        {
          "path": "xmind-generator/xmind_utils.py",
          "symbol": "create_xmind_file"
        }
      ],
      "cli": "xmind-generator/review_xmind.py",
      "input": {
        "type": "object",
        "required": [
          "test_points_path"
        ],
        "optional": [
          "output_dir",
          "company",
          "manager"
        ]
      },
      "output_artifact": "xmind_zip",
      "compatibility": [
        "executable_xmind.py",
        "generate_xmind.py"
      ]
    },
    "requirement-code-auditor": {
      "public_entrypoints": [
        {
          "path": "requirement-code-auditor/scripts/audit_runner.py",
          "symbol": "run_requirement_code_audit"
        },
        {
          "path": "requirement-code-auditor/scripts/workflow_api.py",
          "symbol": "extract_business_logic",
          "input": {
            "required": [
              "repo_path",
              "branch"
            ],
            "optional": [
              "baseline",
              "selected_files"
            ]
          },
          "output_artifact": "code_analysis"
        },
        {
          "path": "requirement-code-auditor/scripts/workflow_api.py",
          "symbol": "compare_structured",
          "input": {
            "required": [
              "requirement_facts",
              "code_evidence"
            ],
            "optional": [
              "dimensions"
            ]
          },
          "output_artifact": "requirement_code_comparison"
        }
      ],
      "cli": "requirement-code-auditor/scripts/cli.py",
      "input": {
        "type": "object",
        "required": [
          "requirement_dir"
        ],
        "optional": [
          "repo_path",
          "branch",
          "baseline",
          "code_targets",
          "config_path",
          "output_dir",
          "mode"
        ]
      },
      "output_artifact": "requirement_code_audit",
      "compatibility": [
        "scripts.analyzer.analyze_code",
        "scripts.comparator.compare_structured",
        "scripts.comparator.compare_from_artifacts",
        "scripts.comparator.compatibility.ReqCodeComparator"
      ]
    }
  },
  "artifacts": {
